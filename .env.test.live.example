# .env.test.live.example — Template for LIVE integration tests
#
# Copy to .env.test.live (gitignored) and fill in REAL sandbox credentials.
# These tests hit real vendor APIs — use test/sandbox accounts only, never production.
#
# Load: happens automatically in config/test_settings.py when NEMI_TEST_ENV=live
# CI: inject the same variable names from your secrets manager (GitHub Actions
#     secrets, HashiCorp Vault, etc.). Code does not care about the source.

# --- Django ---
SECRET_KEY=live-test-secret-key-change-me
TOKEN_ENCRYPTION_KEY=

# --- Internal test fixtures ---
NEMI_TEST_APP_NAME=live-test-app
NEMI_TEST_USER_ID=live-user-123

# ===========================================================
# Tier-1 Social Platforms (Phase 1)
# ===========================================================

# --- Telegram (https://core.telegram.org/bots) ---
# Create a bot via @BotFather; get a test chat_id by messaging the bot then
# calling https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEST_CHAT_ID=

# --- Reddit (https://www.reddit.com/prefs/apps) ---
# Create a "script" app. Use a throwaway test subreddit you moderate.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USERNAME=
REDDIT_PASSWORD=
REDDIT_USER_AGENT=nemi-integration-tests/1.0
REDDIT_TEST_SUBREDDIT=

# --- Discord (https://discord.com/developers/applications) ---
# Create a bot and add it to a test server. Get channel_id from right-click → Copy ID (dev mode).
DISCORD_BOT_TOKEN=
DISCORD_TEST_CHANNEL_ID=

# --- Bluesky (https://bsky.app) ---
# Create a test account. App Password: Settings → App Passwords → generate.
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Mastodon (any instance, e.g. mastodon.social) ---
# Account → Preferences → Development → New Application. Scopes: write:statuses, read.
MASTODON_INSTANCE_URL=
MASTODON_ACCESS_TOKEN=

# ===========================================================
# Cloud Storage (Phase 1)
# ===========================================================

# --- Box (https://developer.box.com) ---
# Create a Custom App (OAuth 2.0 User Authentication).
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_TEST_REFRESH_TOKEN=

# --- Dropbox (https://www.dropbox.com/developers/apps) ---
# Create an app with "Full Dropbox" or "App folder" access. Generate refresh token via OAuth.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_TEST_REFRESH_TOKEN=

# --- Google Drive (https://console.cloud.google.com) ---
# Create OAuth 2.0 Client ID (Desktop or Web app). Scope: https://www.googleapis.com/auth/drive
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=
GOOGLE_TEST_REFRESH_TOKEN=

# --- OneDrive (https://portal.azure.com) ---
# Register an application in Azure AD. API permissions: Files.ReadWrite, offline_access.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_TEST_REFRESH_TOKEN=

# ===========================================================
# Notifications (Phase 1)
# ===========================================================

# --- Apprise (test URL targeting any channel) ---
# Use a throwaway Discord webhook, Telegram bot, or email for tests.
# Format: https://github.com/caronc/apprise/wiki
APPRISE_TEST_URL=
