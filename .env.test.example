# .env.test.example — Template for MOCKED integration tests
#
# Copy to .env.test (gitignored) for local use, or let CI inject these as env vars.
# All values here are dummy — mocked tests never make real API calls.
#
# Load: happens automatically in config/test_settings.py when NEMI_TEST_ENV=mocked

# --- Django ---
SECRET_KEY=test-secret-key-for-mocked-integration-tests
TOKEN_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Internal test fixtures (used by shared conftest for AppClient setup) ---
NEMI_TEST_APP_NAME=test-app
NEMI_TEST_USER_ID=user-123
